{
  "manifest_version": 3,
  "name": "Langlisto Auto Focus",
  "version": "1.0.1",
  "icons": {
    "16": "icons/boar.png",
    "32": "icons/boar.png",
    "48": "icons/boar.png",
    "128": "icons/boar.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "langlisto-autofocus@yatokura",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "description": "Automatically focuses the next Langlisto answer field after a correct answer, or returns to an incorrect one.",
  "content_scripts": [
    {
      "matches": [
        "https://app.langlisto.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
